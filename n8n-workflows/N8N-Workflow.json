    {
      "parameters": {
        "jsCode": "const MALICIOUS_THRESHOLD = 5;\nconst SUSPICIOUS_THRESHOLD = 3;\n\nconst prev = $items(\"Code in JavaScript\")[0].json;\nconst vt = $json.data?.attributes?.last_analysis_stats || {};\n\nconst malicious = vt.malicious || 0;\nconst suspicious = vt.suspicious || 0;\nconst harmless = vt.harmless || 0;\n\nlet decision = prev.decision;\nlet priority = prev.priority;\nlet severity = prev.severity;\n\nlet vt_reason = \"No strong VT indicators\";\n\n// 🔥 VT LOGIC\nif (malicious >= MALICIOUS_THRESHOLD) {\n  decision = \"block\";\n  priority = \"P1\";\n  severity = \"critical\";\n  vt_reason = `${malicious} malicious engines`;\n}\nelse if (suspicious >= SUSPICIOUS_THRESHOLD) {\n  decision = \"monitor\";\n  priority = \"P2\";\n  severity = \"high\";\n  vt_reason = `${suspicious} suspicious engines`;\n}\nelse if (malicious === 0 && suspicious === 0) {\n  if (prev.score >= 70) {\n    decision = \"monitor\";\n    priority = \"P2\";\n    severity = \"high\";\n    vt_reason = \"High AI score, VT clean\";\n  }\n}\n\n// 🔥 MERGE REASON\nconst reason = `[AI] ${prev.reason} | [VT] ${vt_reason}`;\n\n// 🔥 ESCALATION\nconst urgent = (priority === \"P1\" || severity === \"critical\");\n\n// 🔥 SPAM CONTROL\nconst notify = !(\n  malicious === 0 &&\n  suspicious === 0 &&\n  prev.score < 40\n);\n\n// 🔥 OUTPUT\nreturn [\n  {\n    json: {\n      target: prev.target,\n      decision,\n      priority,\n      severity,\n      reason,\n\n      vt_malicious: malicious,\n      vt_suspicious: suspicious,\n      vt_harmless: harmless,\n\n      block: decision === \"block\",\n      notify,\n      ticket: decision !== \"allow\",\n      urgent,\n\n      score: prev.score,\n      message: prev.message,\n\n      timestamp: new Date().toISOString()\n    }\n  }\n];"
      },
