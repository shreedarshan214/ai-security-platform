    {
      "parameters": {
        "jsCode": "// 🔥 Clean AI output\nlet raw = $json.output || \"\";\nraw = raw.replace(/```json|```/g, \"\").trim();\n\nlet ai;\n\ntry {\n  ai = JSON.parse(raw);\n} catch (e) {\n  ai = {\n    decision: \"monitor\",\n    priority: \"P3\",\n    severity: \"medium\",\n    reason: \"AI parsing failed\",\n    automation: {\n      block_immediately: false,\n      notify_team: false,\n      create_ticket: false,\n      run_scan: false\n    }\n  };\n}\n\n// 🔥 PREVIOUS DATA\nconst prev = $items(\"Edit Fields\")[0].json;\nconst scoreNum = Number(prev.score) || 0;\n\n// 🔥 TARGET EXTRACTION\nlet extractedTarget = ai.target || null;\n\nif (!extractedTarget && prev.message) {\n  const urlMatch = prev.message.match(/https?:\\/\\/[^\\s]+/);\n  const domainMatch = prev.message.match(/\\b([a-zA-Z0-9.-]+\\.[a-zA-Z]{2,})\\b/);\n\n  if (urlMatch) {\n    try {\n      extractedTarget = new URL(urlMatch[0]).hostname;\n    } catch {}\n  }\n\n  if (!extractedTarget && domainMatch) {\n    extractedTarget = domainMatch[1];\n  }\n}\n\nif (!extractedTarget) extractedTarget = \"unknown\";\n\n// 🔥 WHITELIST\nconst whitelist = [\"google.com\", \"youtube.com\", \"cloudflare.com\"];\nconst isWhitelisted = whitelist.some(domain =>\n  extractedTarget.endsWith(domain)\n);\n\n// 🔥 SCORE LOGIC\nif (scoreNum >= 91) {\n  ai.decision = ai.decision === \"allow\" ? \"monitor\" : \"block\";\n  ai.priority = \"P1\";\n  ai.severity = \"critical\";\n}\nelse if (scoreNum >= 71) {\n  ai.decision = ai.decision === \"allow\" ? \"monitor\" : \"block\";\n  ai.priority = \"P2\";\n  ai.severity = \"high\";\n}\nelse if (scoreNum >= 31) {\n  ai.decision = \"monitor\";\n  ai.priority = \"P3\";\n  ai.severity = \"medium\";\n}\nelse {\n  ai.decision = \"allow\";\n  ai.priority = \"P4\";\n  ai.severity = \"low\";\n}\n\n// 🔥 WHITELIST SAFETY\nif (isWhitelisted && scoreNum < 70) {\n  ai.decision = \"allow\";\n  ai.priority = \"P4\";\n  ai.severity = \"low\";\n}\n\n// 🔥 UNKNOWN TARGET\nif (extractedTarget === \"unknown\") {\n  ai.priority = \"P2\";\n  ai.severity = \"high\";\n  ai.reason = \"Unknown target — investigate\";\n}\n\n// 🔥 AUTOMATION BASE RULES\nlet automation = {\n  block_immediately: false,\n  notify_team: false,\n  create_ticket: false,\n  run_scan: false\n};\n\nif (ai.decision === \"block\") {\n  automation = {\n    block_immediately: true,\n    notify_team: true,\n    create_ticket: true,\n    run_scan: true\n  };\n}\nelse if (ai.decision === \"monitor\") {\n  automation = {\n    block_immediately: false,\n    notify_team: scoreNum >= 60,\n    create_ticket: scoreNum >= 75,\n    run_scan: true\n  };\n}\n\n// 🔥 🔒 PHASE 8 SAFE BLOCK LOGIC (VERY IMPORTANT)\n\n// Only block if HIGH CONFIDENCE\nconst isHighConfidence =\n  ai.priority === \"P1\" &&\n  scoreNum >= 90;\n\n// Only allow IP (NO domains)\nconst isIP = /^[0-9.]+$/.test(extractedTarget);\n\n// FINAL BLOCK FLAG\nconst safeBlock = isHighConfidence && isIP;\n\n// TTL (auto unblock)\nconst blockTTL = 60;\n\n// 🔥 FINAL OUTPUT\nreturn [\n  {\n    json: {\n      decision: ai.decision,\n      priority: ai.priority,\n      severity: ai.severity,\n\n      target: extractedTarget,\n\n      threat_type: ai.threat_type || \"unknown\",\n      attack_stage: ai.attack_stage || \"unknown\",\n      reason: ai.reason || \"No reason provided\",\n\n      // ✅ FINAL FLAGS\n      block: safeBlock,          // 🔥 USE THIS IN IF\n      notify: automation.notify_team,\n      ticket: automation.create_ticket,\n\n      block_ttl_minutes: blockTTL,\n\n      domain_reputation: ai.enrichment?.domain_reputation || \"unknown\",\n      ip_reputation: ai.enrichment?.ip_reputation || \"unknown\",\n\n      message: prev.message,\n      score: scoreNum,\n      action: prev.action,\n\n      confidence: ai.confidence || 0.8,\n      timestamp: new Date().toISOString()\n    }\n  }\n];"
      },
